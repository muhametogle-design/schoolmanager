# NE-ES School Management System - configuration example
# Copy to ".env" and adjust. Every variable is optional (sane defaults exist).

# --- Application ---
APP_NAME=NE-ES School Management System
APP_VERSION=1.0.0
DEBUG=false

# --- Database ---
# Default: a local SQLite file in the repository root.
DATABASE_URL=sqlite:///./schoolmanager.db
# For Postgres / MySQL use e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/schoolmanager
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/schoolmanager

# --- Security (MUST be changed in production) ---
SECRET_KEY=change-me-to-a-long-random-string
TOKEN_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Seed data (used only on first startup) ---
DEFAULT_SCHOOL_NAME=NE-ES Academy
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
